generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  ACTIVE
  INACTIVE
  DELETED
}

enum StatusAsset {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum StatusReturn{
  RETURNED
  IN_USE
  PENDING
}

enum StatusApproval{
  PENDING
  APPROVED
  REJECTED
}


enum AssignmentType {
  PROJECT
  STAFF
  AREA
}

enum ClasificationType {
  MOVABLE
  INMOVABLE
}

model AssetType {
  id          String   @id @default(uuid())
  categoryId  Json?
  name        String
  description String?
  status Status @default(ACTIVE)
  clasificationType ClasificationType?
  metadata Json?    @map("metadata")
  assets      Asset[]
  assetFieldDefinitions      AssetFieldDefinition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

model Asset {
  id          String   @id @default(uuid())
  assetTypeId String
  gpsDeviceId String?
  code String
  name String
  description String?
  status StatusAsset @default(ACTIVE)
  lastLocation String?
  attributesData Json?
  mainPhotograph String?
  statusApproval StatusApproval?
  commentsApproval String?

  
  gpsDevice GpsDevice? @relation(fields: [gpsDeviceId], references: [id])
  assetTelemetryLogs  AssetTelemetryLog[]
  assetDocuments AssetDocument[]
  assetFolders       AssetFolder[]
  assetGeofences AssetGeofence[]
  assetAssignments AssetAssignment[]
  assetType AssetType @relation(fields: [assetTypeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetTypeId])
}

model AssetTelemetryLog {
  id String @id @default(uuid())
  assetId String
  latitud String
  longitud String
  speed String
  imei String?
  metadata Json?    @map("metadata")
  recordedAt DateTime @default(now())
  asset Asset @relation(fields: [assetId], references: [id])
  isActive Boolean? @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
}

model ApprovalFlowBody{
  id String @id @default(uuid())
  idReference String
  idRequest String?
  metadata Json?    @map("metadata")
  typeAction String
  statusApproval StatusApproval?
  commentsApproval String?
}

model GpsDevice {
  id String @id @default(uuid())
  imei String @unique
  model String?
  phoneNumber String?
  providerCompany String?
  assets Asset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([imei])
}

model AssetFieldDefinition {
  id String @id @default(uuid())
  assetTypeId String
  label String
  fieldType String
  placeholder String?
  options Json?
  metadata Json?    @map("metadata")
  isRequired Boolean
  position Int?
  
  assetDocuments AssetDocument[]
  assetType AssetType @relation(fields: [assetTypeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetTypeId])
 
}


model AssetDocument {
  id String @id @default(uuid())
  fieldDefinitionId String
  assetId String
  fileName String
  fileUrl String
  uploadedAt DateTime @default(now())
  statusApproval StatusApproval?
  commentsApproval String?

  assetDocumentChunks  AssetDocumentChunk[]
  asset Asset @relation(fields: [assetId], references: [id])
  assetFieldDefinition AssetFieldDefinition @relation(fields: [fieldDefinitionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fieldDefinitionId])
  @@index([assetId])
}

model AssetGeofence {
  id String @id @default(uuid())
  assetId String
  name String
  coordinates Json?    @default("[]")
  location String?
  status Status @default(ACTIVE)
  asset Asset @relation(fields: [assetId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])

}

model AssetDocumentChunk {
  id String @id @default(uuid())
  assetDocumentId String
  content String
  embedding String
  
  assetDocument AssetDocument @relation(fields: [assetDocumentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetDocumentId])
}

model AssetAssignment {
  id String @id @default(uuid())
  assetId String
  assignmentType AssignmentType
  projectId String?
  staffId Json?
  areaId Json?
  assignedAt DateTime
  returnedAt DateTime?
  statusReturned StatusReturn?
  statusApproval StatusApproval?
  commentsApproval String?

  asset Asset @relation(fields: [assetId], references: [id])
  project   Project?   @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
  @@index([projectId])
  @@index([staffId])
  @@index([areaId])
}

model Project{
  id String @id @default(uuid())
  name String
  code String
  status Status @default(ACTIVE)
  typeId String?

  assetAssignments AssetAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssetFolder {
  id          String        @id @default(uuid())
  assetId     String
  name        String
  
  parentId    String?       
  parent      AssetFolder?  @relation("SubCarpetas", fields: [parentId], references: [id], onDelete: Cascade)
  subfolders  AssetFolder[] @relation("SubCarpetas")

  asset       Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  files       AssetFile[]   

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([assetId])
  @@index([parentId])
}

model AssetFile {
  id        String      @id @default(uuid())
  folderId  String      
  name      String      
  fileUrl   String      
  fileType  String?     
  sizeBytes Int?        
  

  folder    AssetFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([folderId])
}

model Catalog {
  id String @id @default(uuid())
  key String        @unique
  name String
  description String?
  status Status @default(ACTIVE)

  items       CatalogItem[]

  @@map("catalogs")
}

model CatalogItem {
  id          String        @id @default(uuid())
  catalogId   String        @map("catalog_id")
  key         String
  name        String
  description String?
  config      Json? 
  status      Status @default(ACTIVE)

  catalog     Catalog       @relation(fields: [catalogId], references: [id], onDelete: Cascade)

  @@unique([catalogId, key])
  @@map("catalog_items")
}
